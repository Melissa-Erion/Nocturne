# Supabase connection. The publishable key is safe to ship in the app: Row-Level Security
# restricts every table to the signed-in user. NEVER put the secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://nfdfmlnffbktlwrccfom.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_J6mB3NRIIBjH4ROrqcZlcQ_Adx_AuF_
# The USDA FoodData Central key is NOT set here: anything in this file ships inside the app and is public.
# It is stored as the USDA_API_KEY secret in Supabase (Edge Functions → Secrets) and used by the usda-search function.
# RevenueCat Billing (Stripe) public web keys. Public by design, like the Supabase publishable key.
# NEVER put a RevenueCat or Stripe secret key (sk_...) here.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=rcb_OwttbeJbbzLTZIXptJGzcbZgHafC
EXPO_PUBLIC_REVENUECAT_WEB_SANDBOX_KEY=rcb_sb_tdbCjwpxrgKwttJjEzKoMiCMi
# Payments: off = everything open, nobody charged; sandbox = paywall on with Stripe test cards (no real charges);
# live = real payments.
EXPO_PUBLIC_BILLING=live
# Google "Sign in with Google" button on the web (public client ID; the client secret stays in Supabase only).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=534010316398-lsmcf17lnnt12hj6e1736qthe75sund6.apps.googleusercontent.com
